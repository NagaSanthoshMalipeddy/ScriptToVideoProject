[
  ["ఒక యుద్ధాన్ని ఊహించండి… అది కొనసాగింది…"],
  ["ఎనిమిది సంవత్సరాలు."],
  ["రెండు పొరుగు దేశాలు."],
  ["లక్షలాది ప్రజలు ప్రభావితమయ్యారు."],
  ["నగరాలపై బాంబులు."],
  ["చమురు కేంద్రాలపై దాడులు."],
  ["20వ శతాబ్దంలో అత్యంత సుదీర్ఘమైన,", "రక్తసిక్తమైన సంప్రదాయ యుద్ధాల్లో ఒకటి."],
  ["ఇదే ఇరాన్ – ఇరాక్ యుద్ధం."],
  ["కానీ ఇరాక్ ఇరాన్‌పై ఎందుకు దండెత్తింది?"],
  ["యుద్ధం ఎనిమిదేళ్లు ఎందుకు కొనసాగింది?"],
  ["చివరకు ఎలా ముగిసింది?"],
  ["1980కి వెళ్దాం."],
  ["యుద్ధాన్ని అర్థం చేసుకోవాలంటే, మ్యాప్ చూడండి."],
  ["ఇది ఇరాక్."],
  ["దానికి సరిగ్గా తూర్పున…"],
  ["ఇరాన్."],
  ["రెండు దేశాలకూ పొడవైన,", "వ్యూహాత్మకంగా కీలకమైన సరిహద్దు ఉంది."],
  ["ముఖ్యమైన ప్రాంతం — షట్ అల్-అరబ్ జలమార్గం,", "టైగ్రిస్, యూఫ్రటీస్ నదులు కలిసి", "పర్షియన్ గల్ఫ్ వైపు ప్రవహించే చోటు."],
  ["ఈ సరిహద్దు, జలమార్గ నియంత్రణపై", "ఏళ్ల తరబడి వివాదం ఉంది."],
  ["కానీ మరో పెద్ద పరిణామం జరిగింది."],
  ["1979లో ఇరాన్‌లో ఇస్లామిక్ విప్లవం వచ్చింది."],
  ["రాచరికం కూలిపోయింది,", "ఆయతొల్లా రుహొల్లా ఖొమేనీ నేతృత్వంలో", "ఇస్లామిక్ రిపబ్లిక్ ఏర్పడింది."],
  ["ఈ విప్లవం ఇరాన్ ప్రభుత్వాన్ని,", "పొరుగు దేశాలతో సంబంధాలను బాగా మార్చేసింది."],
  ["ఇరాక్ నాయకుడు సద్దాం హుస్సేన్", "ఇరాన్ రాజకీయంగా అస్థిరంగా ఉందని భావించాడు."],
  ["ఈ ప్రాంతంలో ఇరాక్ స్థానాన్ని", "బలపరుచుకునే అవకాశంగా కూడా చూశాడు."],
  ["ఉద్రిక్తతలు వేగంగా పెరిగాయి."],
  ["ఆ తర్వాత…"],
  ["ఇరాక్ తన అడుగు వేసింది."],
  ["సెప్టెంబర్ 22, 1980."],
  ["మ్యాప్ చూడండి."],
  ["ఇరాక్ జెండా పశ్చిమ వైపు కనిపిస్తుంది."],
  ["ఆ తర్వాత…"],
  ["అది తూర్పు వైపు కదలడం మొదలవుతుంది."],
  ["ఇరాక్ సైన్యం ఇరాన్‌పై", "భారీ దండయాత్ర ప్రారంభించింది."],
  ["అనేక ఇరాక్ దళాలు సరిహద్దు దాటాయి."],
  ["పశ్చిమ ఇరాన్‌లో లక్ష్యాలపై దాడి చేసి,", "ఇరాన్ సైనిక, మౌలిక సదుపాయాలపై", "వైమానిక దాడులు జరిపింది."],
  ["ఇరాన్ రాజకీయ గందరగోళం, సైనిక సమస్యలు", "దాన్ని బలహీనం చేస్తాయని అంచనా."],
  ["మొదట్లో ఇరాక్ భూభాగాన్ని ఆక్రమించింది."],
  ["కానీ యుద్ధం అనుకున్నట్టు జరగలేదు."],
  ["ఇరాన్ తన సైన్యాన్ని, విప్లవ దళాలను", "సమీకరించడం మొదలుపెట్టింది."],
  ["కూలిపోవడానికి బదులు…"],
  ["ఇరాన్ తిరిగి పోరాడింది."],
  ["ఇరాక్ ముందడుగు నెమ్మదించింది."],
  ["ఆ తర్వాత ఆగిపోయింది."],
  ["చివరకు…"],
  ["యుద్ధ దిశ మారడం మొదలైంది."],
  ["ఇరాన్ జెండా పశ్చిమం వైపు కదులుతుంది."],
  ["ఇరాన్ ప్రతిదాడులు చేసి, ఇరాక్ ఆక్రమించిన", "భూభాగంలో చాలా భాగాన్ని క్రమంగా తిరిగి పొందింది."],
  ["1982 నాటికి ఇరాన్ సైన్యం,", "ఆక్రమిత ఇరాన్ భూభాగంలో చాలా భాగం నుండి", "ఇరాక్ దళాలను తరిమేసింది."],
  ["ఈ దశలో యుద్ధాన్ని ముగించే", "అవకాశం ఇరాక్‌కు ఉంది."],
  ["కానీ యుద్ధం కొనసాగింది."],
  ["దండయాత్రకు ఇరాక్ బాధ్యత వహించాలని ఇరాన్ డిమాండ్ చేసింది,", "శాశ్వత ఒప్పందానికి ముందు ఇతర షరతులు కూడా పెట్టింది."],
  ["ఆ తర్వాత ఇరాన్ సైన్యం", "ఇరాక్ భూభాగంలోకి ప్రవేశించింది."],
  ["యుద్ధం పూర్తిగా మారిపోయింది."],
  ["చిన్న దండయాత్రకు బదులు…"],
  ["అది సుదీర్ఘ అలసట యుద్ధంగా మారింది."],
  ["రెండు వైపులా ఒకరినొకరు", "అలసిపోయేలా చేయాలని ప్రయత్నించాయి."],
  ["ఏ వైపూ సులభంగా", "నిర్ణయాత్మక విజయం సాధించలేకపోయింది."],
  ["1982."],
  ["1983."],
  ["1984."],
  ["1985."],
  ["యుద్ధ రేఖ ముందుకు కదులుతుంది…"],
  ["మళ్లీ వెనక్కి వస్తుంది."],
  ["ఏ వైపూ నిర్ణయాత్మక పురోగతి సాధించదు."],
  ["ఈ ఘర్షణ మరింతగా అలసట యుద్ధంగా మారింది."],
  ["రెండు దేశాలూ సైనిక స్థావరాలపై దాడులు చేశాయి."],
  ["కానీ యుద్ధం యుద్ధభూమికే పరిమితం కాలేదు."],
  ["చమురు అత్యంత కీలకమైంది."],
  ["ఇరాన్, ఇరాక్ రెండూ", "చమురు ఆదాయంపైనే ఎక్కువగా ఆధారపడ్డాయి."],
  ["అందుకే చమురు కేంద్రాలు, నౌకా రవాణా", "లక్ష్యాలుగా మారాయి."],
  ["దీంతో ఘర్షణ పర్షియన్ గల్ఫ్‌కు విస్తరించింది."],
  ["వాణిజ్య నౌకలపై దాడులు జరిగాయి."],
